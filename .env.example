# 복사해서 .env 로 쓰세요 (cp .env.example .env). .env 는 git에 올리지 않습니다.

# Supabase 대시보드 → Project Settings → API Keys / Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — 예전 프로젝트라면 legacy "anon" 키도 됩니다.
# secret / service_role 키는 RLS를 우회하므로 여기에 넣지 마세요.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
# 로컬은 127.0.0.1 (내 PC에서만 접속). Render 등 클라우드는 0.0.0.0
HOST=127.0.0.1
# 배포 시 production 으로 (쿠키를 https 전용으로)
NODE_ENV=development
# 가입 확인 메일 링크가 돌아올 주소 (배포 후에는 배포 주소로)
APP_URL=http://localhost:3000
